{
  "name": "compilestrength",
  "description": "Build a full-stack web application with Next.js.",
  "private": true,
  "scripts": {
    "build": "next build",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv env.d.ts",
    "check": "npm run typecheck && npm run build",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "dev": "next dev",
    "fix": "biome check --write .",
    "format": "biome format --write --unsafe .",
    "format:check": "biome format .",
    "lint": "eslint .",
    "biocheck": "biome check --write --unsafe",
    "lint:biome": "biome lint .",
    "lint:biome:fix": "biome lint --write .",
    "ngrok": "ngrok http --domain=${NGROK_DOMAIN:-goblin-mature-annually.ngrok-free.app} 3000",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "start": "next start",
    "test": "vitest",
    "test:changed": "./scripts/test-changed.sh",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "typecheck": "tsc --noEmit",
    "test:run": "vitest run",
    "build:cf": "opennextjs-cloudflare build"
  },
  "cloudflare": {
    "label": "Next.js Framework Starter",
